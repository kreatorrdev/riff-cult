# Local development runs on http://127.0.0.1:4318.
BETTER_AUTH_URL=http://127.0.0.1:4318
# Generate at least 32 random bytes for deployment. Never commit the actual secret.
BETTER_AUTH_SECRET=
# Leave empty locally to use disk-backed embedded PostgreSQL.
DATABASE_URL=
# PGLITE_DIR=.data/postgres
# Set true only for a single-process local production preview, not serverless hosting.
# ALLOW_LOCAL_DATABASE=true
# Vercel without DATABASE_URL automatically uses the portfolio demo.
# DEMO_MODE=true
# DEMO_MODE=false explicitly requires real application credentials and a database.
# PUBLIC_INDEXING=true
